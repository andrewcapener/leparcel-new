node_modules
.next
*.db
*.db-journal
.env*.local
*.db-shm
*.db-wal
/public/build-info.json

# Scratch files. A throwaway query script written at the repo root got swept
# into a commit by `git add -A`; these patterns stop that recurring. The
# .scratch.mts ones have to sit at the repo root rather than in a temp
# directory, because they import the project's own dependencies and tsx
# resolves those from where the file is.
/.peek.ts
/.realrow*.ts
/*.peek.ts
/*.scratch.mts

# Body-face candidates for the typography comparison. A proposal, not a
# dependency: only the face that actually gets chosen moves up into
# public/theme/fonts/ and gets committed.
/public/theme/fonts/candidates/

# Subagent worktrees. Parallel agents get their own checkout under here, so
# this is live git plumbing rather than project files: committing it would
# commit a worktree into the repository it is a worktree of.
/.claude/worktrees/

# TypeScript's incremental build cache. "incremental": true in tsconfig.json
# rewrites this on every tsc run, so tracking it means every typecheck dirties
# the tree and it rides along in whatever commit happens next. It is generated,
# it is machine-local, and nothing reads it but tsc.
/tsconfig.tsbuildinfo

# Rendered social-card candidates. Generated scratch for choosing a direction:
# the one that wins gets built by src/server/modules/og/card.tsx at request
# time, so no PNG from here is ever the thing that ships.
/.og-options/
